<Window x:Class="Hatrack.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hatrack" Width="1120" Height="760" MinWidth="920" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="24">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="0,10,0,38"><Viewbox Width="32" Height="32" Margin="0,0,12,0"><Canvas Width="64" Height="64"><Path Fill="{DynamicResource Ink}" Data="F1 M14.25 29.5H49.75A2.25 2.25 0 0 1 49.75 34H14.25A2.25 2.25 0 0 1 14.25 29.5Z M4.25 58H59.75A2.25 2.25 0 0 1 59.75 62.5H4.25A2.25 2.25 0 0 1 4.25 58Z M27 2H37A2.5 2.5 0 0 1 39.5 4.5V20.5A2.5 2.5 0 0 1 37 23H27A2.5 2.5 0 0 1 24.5 20.5V4.5A2.5 2.5 0 0 1 27 2Z M21.5 21H42.5A2.5 2.5 0 0 1 42.5 26H21.5A2.5 2.5 0 0 1 21.5 21Z M5.5 50H26.5A2.5 2.5 0 0 1 26.5 55H5.5A2.5 2.5 0 0 1 5.5 50Z M37.5 50H58.5A2.5 2.5 0 0 1 58.5 55H37.5A2.5 2.5 0 0 1 37.5 50Z M7 52V45A9 9 0 0 1 25 45V52Z M39 52V45A9 9 0 0 1 57 45V52Z"/></Canvas></Viewbox><TextBlock Text="Hatrack" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <Button x:Name="AllNav" Tag="Selected" Style="{StaticResource NavButton}" Content="All profiles" Click="All_Click" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>
     <Button x:Name="FavoritesNav" Style="{StaticResource NavButton}" Content="Favourites" Click="Favorites_Click" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>
     <Button Style="{StaticResource NavButton}" Content="Find existing profiles" Click="Discover_Click" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>
     <Button Style="{StaticResource NavButton}" Content="Locate desktop app" Click="Locate_Click" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>
     <Button Style="{StaticResource NavButton}" Content="Diagnostics" Click="Diagnostics_Click" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="Appearance" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/><ComboBox x:Name="Theme" SelectionChanged="Theme_Changed"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox><TextBlock x:Name="VersionText" Margin="0,24,0,4" Foreground="{DynamicResource Muted}"/><TextBlock Text="Claude and Codex Desktop" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="36,32,36,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button DockPanel.Dock="Right" Content="Create profile" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="Create_Click"/><StackPanel><TextBlock Text="Your profiles" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Create, customise, and open desktop profiles." Margin="0,8,0,0" Foreground="{DynamicResource Muted}"/></StackPanel></DockPanel>
   <Border Grid.Row="1" Background="{DynamicResource Surface}" Padding="18" Margin="0,24,0,20" CornerRadius="16"><StackPanel><TextBlock x:Name="InstallStatus" Text="Looking for desktop apps…" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="Preview build: desktop sign-in isolation must be verified before a stable release." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel></Border>
   <Grid Grid.Row="2" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Search profiles" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="Search" TextChanged="Filter_Changed" ToolTip="Search profile names" AutomationProperties.Name="Search profiles"/></StackPanel><ComboBox Grid.Column="1" x:Name="AppFilter" Margin="12,22,0,0" VerticalAlignment="Top" SelectionChanged="Filter_Changed" SelectedIndex="0"><ComboBoxItem Content="All desktop apps"/><ComboBoxItem Content="Claude Desktop"/><ComboBoxItem Content="Codex Desktop"/></ComboBox></Grid>
   <Grid Grid.Row="3"><ListBox x:Name="ProfileList" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
    <ListBox.ItemContainerStyle><StaticResource ResourceKey="ProfileItem"/></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding IconSource}" RenderOptions.BitmapScalingMode="HighQuality" Width="40" Height="40"/><StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource Muted}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Open" Click="Open_Click" Tag="{Binding Id}" AutomationProperties.Name="Launch selected profile"/><Button Content="Edit" Click="Edit_Click" Tag="{Binding Id}" AutomationProperties.Name="Edit selected profile"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"><TextBlock x:Name="EmptyTitle" Text="Create your first profile." FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyCopy" Text="Create your first profile, or find the ones you already use. Existing logins and shortcuts stay where they are." Margin="0,12,0,22" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}"/><Button Content="Create your first profile" Click="Create_Click" HorizontalAlignment="Center"/></StackPanel></Grid>
   <TextBlock Grid.Row="4" x:Name="Status" Text="No profile data is uploaded. Sign in inside each official desktop app." Foreground="{DynamicResource Muted}" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"/>
  </Grid>
 </Grid>
</Window>
