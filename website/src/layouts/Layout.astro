---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
const {title='Hatrack | Multiple Claude Desktop & Codex accounts on Windows',description='Free, open-source Windows app for running multiple Claude Desktop and Codex Desktop accounts. Separate profiles, shortcuts and icons for personal, work and client sessions.',faq=null}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const repository=process.env.REPOSITORY_URL || 'https://github.com/MuneefMumthas/hatrack';
const canonical=new URL(Astro.url.pathname,Astro.site);
const home=new URL(base+'/',Astro.site).toString();
const image=new URL(`${base}/social.png`,Astro.site).toString();
const schema=[{'@context':'https://schema.org','@type':'SoftwareApplication',name:'Hatrack',alternateName:'Hatrack profile manager',applicationCategory:'UtilitiesApplication',applicationSubCategory:'Profile manager',operatingSystem:'Windows 11 x64',softwareVersion:'0.2.0-preview',description,image,screenshot:new URL(`${base}/desktop.png`,Astro.site).toString(),downloadUrl:repository+'/releases',installUrl:repository+'/releases',codeRepository:repository,isAccessibleForFree:true,author:{'@type':'Person',name:'Muneef Mumthas',url:'https://github.com/MuneefMumthas'},offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},license:repository+'/blob/main/LICENSE',url:home},...(faq?[{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]:[])];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#FAFAFA"/><title>{title}</title><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href={`${base}/logo.svg`}/><link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`}/><meta name="author" content="Muneef Mumthas"/>{process.env.GOOGLE_SITE_VERIFICATION&&<meta name="google-site-verification" content={process.env.GOOGLE_SITE_VERIFICATION}/>}{process.env.BING_SITE_VERIFICATION&&<meta name="msvalidate.01" content={process.env.BING_SITE_VERIFICATION}/>}<meta property="og:type" content="website"/><meta property="og:site_name" content="Hatrack"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Hatrack: multiple Claude Desktop and Codex accounts on Windows"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/><script is:inline>
  try {
    const saved = localStorage.getItem('hatrack-appearance');
    document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  } catch { document.documentElement.dataset.theme = 'light'; }
</script></head>
<body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="wordmark" href={`${base}/`} aria-label="Hatrack home"><img src={`${base}/logo.svg`} width="36" height="36" alt=""/>Hatrack</a><nav aria-label="Main navigation"><a href={`${base}/guides/`}>Guides</a><a href={repository}>Source code<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a><a class="button small" href={`${base}/download/`}>Get Hatrack</a><button class="theme-toggle" type="button" aria-label="Switch to dark appearance" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg></button></nav></header><main id="main"><slot/></main><footer><a class="wordmark" href={`${base}/`}><img src={`${base}/logo.svg`} width="28" height="28" alt=""/>Hatrack</a><p>A personal open-source project by Muneef Mumthas.<br/>Independent of Anthropic and OpenAI. Desktop apps only.</p><div><a href={`${base}/guides/privacy/`}>Privacy &amp; ownership</a><a href={repository+'/blob/main/LICENSE'}>MIT licence</a><a href={repository+'/issues'}>Report an issue</a><a href={repository}>Star on GitHub</a></div></footer><script is:inline>
  const toggle = document.querySelector('.theme-toggle');
  function updateAppearanceLabel() {
    const dark = document.documentElement.dataset.theme === 'dark';
    toggle.setAttribute('aria-label', dark ? 'Switch to light appearance' : 'Switch to dark appearance');
    toggle.setAttribute('aria-pressed', String(dark));
    document.querySelector('meta[name="theme-color"]').content = dark ? '#111113' : '#FAFAFA';
  }
  toggle.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('hatrack-appearance', theme); } catch {}
    updateAppearanceLabel();
  });
  updateAppearanceLabel();
</script></body></html>
