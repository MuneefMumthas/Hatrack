---
import Layout from '../../layouts/Layout.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const guides=[['second-claude-account','Use a second Claude account without logging out','Keep personal and work accounts open side by side.'],['claude-desktop','Multiple Claude Desktop accounts','Separate personal, work, and client desktop sessions.'],['codex-desktop','Multiple Codex Desktop accounts','How desktop and agent state are separated, and what still needs verification.'],['custom-icons','Profile icons and colours','Actual app logos, custom colours, and local image uploads.'],['troubleshooting','Detection and launch troubleshooting','Manual app locations, missing installations, and Windows package errors.'],['privacy','Privacy and ownership','Where data lives and what removal preserves.']];
---
<Layout title="Hatrack guides | Multiple Claude & Codex Desktop accounts" description="Set up multiple Claude Desktop and Codex Desktop accounts on Windows with Hatrack: profiles, icons, troubleshooting and privacy."><article class="article"><h1>Setup guides</h1><p class="lead">Create and manage Claude and Codex desktop profiles on Windows. CLI tools are not supported.</p><div class="guide-list">{guides.map(([slug,title,description])=><a href={`${base}/guides/${slug}/`}><h2>{title}</h2><p>{description}</p><span aria-hidden="true">→</span></a>)}</div></article></Layout>
